{
  "name": "icu-retraining-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs server/*.test.mjs",
    "test:routes": "node --test server/*.test.mjs",
    "test-job:create": "node server/scripts/dummy-s3-job.mjs create",
    "test-job:replace": "node server/scripts/dummy-s3-job.mjs create --replace",
    "test-job:delete": "node server/scripts/dummy-s3-job.mjs delete",
    "test-job-105:create": "node server/scripts/load-test-105-s3-job.mjs create",
    "test-job-105:replace": "node server/scripts/load-test-105-s3-job.mjs create --replace",
    "test-job-105:delete": "node server/scripts/load-test-105-s3-job.mjs delete",
    "race-test-job:create": "node server/scripts/race-lounge-s3-job.mjs create",
    "race-test-job:replace": "node server/scripts/race-lounge-s3-job.mjs create --replace",
    "race-test-job:delete": "node server/scripts/race-lounge-s3-job.mjs delete",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.41.0",
    "next": "^16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
